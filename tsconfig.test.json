{
  /* Tests get the same rules as the app, plus Node types: some of them read the
     source tree to check the interface against the glossary. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["src"],
  "exclude": []
}
